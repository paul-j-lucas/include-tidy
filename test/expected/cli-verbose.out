$ include-tidy -Xtidy --directory=data -Xtidy --no-config-layers -Xtidy --config=../../etc/config.toml -Xtidy --verbose=- hello.c

$ include-tidy -Xtidy --directory=data -Xtidy --no-config-layers -Xtidy --config=../../etc/config.toml -Xtidy --verbose=dFs hello.c
// tidy | source file: "hello.c"
// tidy | 
// tidy | change directory: "data"
// tidy | 
// tidy | symbols:
// tidy |   "printf" -> <stdio.h>

$ include-tidy -Xtidy --directory=data -Xtidy --no-config-layers -Xtidy --config=explicit-proxy.toml -Xtidy --verbose=P explicit-proxy.c
// tidy | explicit proxies:
// tidy |   "config.h" -> "pjl_config.h"

