EXPECTED_EXIT=0

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --verbose=f \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --verbose=F \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-style=none \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-style="//" \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-style="/*" \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --verbose=i \
  hello.c

# vim:set syntax=bash et sw=2 ts=2:
