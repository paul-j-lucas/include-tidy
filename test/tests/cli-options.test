test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --line-length=65 \
  comment-symbols.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy -A \
  -Xtidy -l65 \
  comment-symbols.c

