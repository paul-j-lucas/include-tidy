EXPECTED_EXIT=0

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --color=never \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --color never \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy -knever \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy -k never \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --align-column=35 \
  hello.c

test_include_tidy $TIDY_TEST_CXXFLAGS $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy -A \
  -Xtidy -a35 \
  -xc++ \
  hello.cpp

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy -Aa35 \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-style=none \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy -Snone \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-style="//" \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-style="/*" \
  hello.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-symbols=alpha \
  comment-symbols.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-symbols=length \
  comment-symbols.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-symbols=most-used \
  comment-symbols.c

