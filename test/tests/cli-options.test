  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy --comment-symbols=ref-count \
  comment-symbols.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy -Salpha \
  comment-symbols.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy -Slength \
  comment-symbols.c

test_include_tidy $TIDY_TEST_OPTIONS \
  $TIDY_TEST_CONFIG \
  -Xtidy --all-includes \
  -Xtidy -Smost-used \
